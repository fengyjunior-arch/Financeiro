# Copie para .env.local para rodar no seu computador. Na Vercel, cadastre em
# Settings > Environment Variables. Nunca coloque os valores reais no código.

# Chaves da Pluggy (painel da Pluggy > Applications)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Códigos das conexões de banco, separados por vírgula. O app mostra o código
# depois que você conecta o banco em /conectar.
PLUGGY_ITEM_IDS=

# Senha para entrar no app
APP_PASSWORD=

# Opcional: protege a atualização diária automática (qualquer texto longo e aleatório)
CRON_SECRET=

# Opcional: 1 mostra os bancos de teste da Pluggy na tela de conexão
PLUGGY_SANDBOX=
